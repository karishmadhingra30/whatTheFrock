{
  "manifest_version": 3,
  "name": "whatTheFrock",
  "version": "1.0",
  "description": "Health exposure risk score for H&M clothing fabric composition",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://www.hm.com/*",
    "*://www2.hm.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.hm.com/*/productpage*", "*://www2.hm.com/*/productpage*"],
      "js": ["overlay.js", "content.js"],
      "css": ["overlay.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
